class Solution:
    def isValid(self, s: str) -> bool:
        stack = []

        for c in s:
            if c == "(":
                stack.append(")")
            elif c == "{":
                stack.append("}")
            elif c =="[":
                stack.append("]")
            else:
                if c != stack.pop():
                    return False
        return (len(stack) == 0)


